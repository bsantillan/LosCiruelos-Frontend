# Copiar este archivo como .env y completar los valores.
# Vite solo expone al navegador las variables que empiezan con VITE_.
# Ojo: todo lo que se ponga acá termina en el bundle público, no guardar secretos.

# URL base del backend, sin barra final. Ej: http://localhost:8080/api
VITE_API_URL=

# Client ID de OAuth 2.0 de Google (Google Cloud Console → Credenciales).
# Ej: 1234567890-abc123.apps.googleusercontent.com
VITE_GOOGLE_CLIENT_ID=

# Public Key de Mercado Pago (Tus integraciones → Credenciales). Es la clave
# PÚBLICA, no el access token. Tiene que ser de la misma cuenta y del mismo
# entorno (prueba / producción) que el access token que usa el backend.
# Ej: TEST-12345678-abcd-...  o  APP_USR-12345678-abcd-...
VITE_MP_PUBLIC_KEY=
